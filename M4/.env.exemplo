# URLs de referência. O Alembic, o ferramentas/semear.py e o modelo_de_dados leem DATABASE_URL
# do terminal: defina com export (Linux e macOS) ou $env: (PowerShell), como no README.
# SQLite (padrão quando DATABASE_URL não está definida):
# DATABASE_URL=sqlite:///escola.db
# PostgreSQL do docker-compose.yml:
DATABASE_URL=postgresql+psycopg://escola:escola@localhost:5432/escola
